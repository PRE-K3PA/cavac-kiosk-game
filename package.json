{
	"name": "cavac-kiosk-game",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"description": "CAVAC 전시 부스 키오스크 게임",
	"main": "dist-electron/main/main.js",
	"scripts": {
		"dev": "vite",
		"build": "bun run typecheck && vite build",
		"preview": "vite preview",
		"dist": "bun run build && electron-builder",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"clean": "bun run clean:build && rm -rf node_modules",
		"clean:build": "rm -rf dist dist-electron release"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"motion": "^13.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@happy-dom/global-registrator": "^20.14.5",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "^44.4.3",
		"electron-builder": "^26.15.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-plugin-electron": "^1.1.2"
	}
}
