diff --git a/templates/nsis/portable.nsi b/templates/nsis/portable.nsi
index e5436bb0f810058b52e15ce65b3d256f86dabc6f..ae466c1dd46eece9125efed395afca2bc87afdbd 100644
--- a/templates/nsis/portable.nsi
+++ b/templates/nsis/portable.nsi
@@ -30,12 +30,23 @@ Section
     HideWindow
   !endif
 
-  StrCpy $INSTDIR "$PLUGINSDIR\app"
-  !ifdef UNPACK_DIR_NAME
-    StrCpy $INSTDIR "$TEMP\${UNPACK_DIR_NAME}"
-  !endif
+  # 풀어 둔 앱을 끝날 때 지우지 않고 빌드별 폴더에 남겨 두고, 다음부터는 풀지 않고 바로 실행합니다 (#205)
+  !define /date CACHE_BUILD_ID "%Y%m%d%H%M%S"
+  !define CACHE_ROOT "$LOCALAPPDATA\${APP_FILENAME} Portable"
+  StrCpy $INSTDIR "${CACHE_ROOT}\${CACHE_BUILD_ID}"
+  IfFileExists "$INSTDIR\.ok" RunApp 0
+
+  # 처음 푸는 중에 같은 exe 를 또 켜면 풀던 폴더를 지우게 되므로, 먼저 푸는 쪽만 진행합니다
+  System::Call 'kernel32::CreateMutex(i 0, i 1, t "CavacKioskPortableExtract") i .r1 ?e'
+  Pop $2
+  ${if} $2 = 183
+    Quit
+  ${endIf}
 
-  RMDir /r $INSTDIR
+  # 새 빌드를 처음 켤 때 옛 빌드가 남긴 폴더를 함께 지웁니다
+  RMDir /r "${CACHE_ROOT}"
+  # .tmp 에 다 푼 뒤 이름을 바꿔서, 풀다 전원이 꺼져도 덜 풀린 폴더를 실행하지 않습니다
+  StrCpy $INSTDIR "${CACHE_ROOT}\${CACHE_BUILD_ID}.tmp"
   SetOutPath $INSTDIR
 
   !ifdef APP_DIR_64
@@ -74,6 +85,16 @@ Section
     !endif
   !endif
 
+  FileOpen $0 "$INSTDIR\.ok" w
+  FileClose $0
+  SetOutPath $LOCALAPPDATA
+  ClearErrors
+  Rename "${CACHE_ROOT}\${CACHE_BUILD_ID}.tmp" "${CACHE_ROOT}\${CACHE_BUILD_ID}"
+  IfErrors RunApp 0
+  StrCpy $INSTDIR "${CACHE_ROOT}\${CACHE_BUILD_ID}"
+
+  RunApp:
+  SetOutPath $INSTDIR
   System::Call 'Kernel32::SetEnvironmentVariable(t, t)i ("PORTABLE_EXECUTABLE_DIR", "$EXEDIR").r0'
   System::Call 'Kernel32::SetEnvironmentVariable(t, t)i ("PORTABLE_EXECUTABLE_FILE", "$EXEPATH").r0'
   System::Call 'Kernel32::SetEnvironmentVariable(t, t)i ("PORTABLE_EXECUTABLE_APP_FILENAME", "${APP_FILENAME}").r0'
@@ -86,6 +107,4 @@ Section
 	ExecWait "$INSTDIR\${APP_EXECUTABLE_FILENAME} $R0" $0
   SetErrorLevel $0
 
